{
  "name": "emitkit",
  "version": "3.0.0",
  "private": true,
  "description": "Event tracking and push notifications on a single Cloudflare Worker.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "docs:dev": "pnpm --filter @emitkit/docs dev",
    "docs:build": "pnpm --filter @emitkit/docs build",
    "build": "vite build && tsx --tsconfig tsconfig.node.json scripts/prerender-www.ts && pnpm docs:build && tsx --tsconfig tsconfig.node.json scripts/bundle-docs.ts",
    "preview": "vite preview",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.web.json && tsc -p tsconfig.node.json && pnpm --filter @emitkit/docs validate",
    "verify": "pnpm check && pnpm typecheck && pnpm build",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "wrangler d1 execute DB --local --file=seed/local.sql",
    "e2e": "playwright test",
    "e2e:prod": "E2E_TARGET=production playwright test",
    "release": "pnpm build && pnpm state:check --env-file .env.local && alchemy deploy --stage prod --env-file .env.local --yes",
    "ci:check": "pnpm check && pnpm typecheck && CLOUDFLARE_API_TOKEN=\"${EMITKIT_DEPLOY_TOKEN:?set the EMITKIT_DEPLOY_TOKEN build secret}\" pnpm state:check",
    "deploy:ci": "export CLOUDFLARE_API_TOKEN=\"${EMITKIT_DEPLOY_TOKEN:?set the EMITKIT_DEPLOY_TOKEN build secret}\" && pnpm state:check && alchemy deploy --stage prod --yes",
    "state:check": "tsx --tsconfig tsconfig.node.json scripts/alchemy-state.ts check",
    "state:migrate": "tsx --tsconfig tsconfig.node.json scripts/alchemy-state.ts migrate",
    "db:auth-schema": "tsx --tsconfig tsconfig.node.json scripts/generate-auth-schema.ts",
    "billing:push": "atmn push",
    "e2e:report": "tsx --tsconfig e2e/tsconfig.json e2e/support/report.ts"
  },
  "dependencies": {
    "@better-auth-ui/core": "1.7.26",
    "@better-auth-ui/heroui": "1.7.26",
    "@better-auth-ui/react": "1.7.26",
    "@better-auth/api-key": "1.7.5",
    "@better-auth/passkey": "1.7.5",
    "@effect/sql-d1": "4.0.0-rc.117",
    "@emitkit/js": "3.0.0",
    "@gravity-ui/icons": "2.22.0",
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@internationalized/date": "3.12.4",
    "@number-flow/react": "0.6.2",
    "@openpanel/sdk": "1.3.1",
    "@openpanel/web": "1.4.1",
    "@opentelemetry/api": "1.9.1",
    "@orpc/client": "1.14.11",
    "@orpc/contract": "1.14.11",
    "@orpc/experimental-effect": "1.14.11",
    "@orpc/server": "1.14.11",
    "@orpc/tanstack-query": "1.14.11",
    "@parsew/sdk": "0.12.0",
    "@pushforge/builder": "2.0.5",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-pacer": "0.23.0",
    "@tanstack/react-query": "5.103.2",
    "@tanstack/react-router": "1.170.39",
    "@tanstack/react-store": "0.11.1",
    "@tanstack/react-table": "9.2.4",
    "@trakoo/emitkit": "1.0.0",
    "@trakoo/openpanel": "1.2.0",
    "better-auth": "1.7.5",
    "bowser": "2.14.1",
    "clsx": "2.1.1",
    "effect": "4.0.0-rc.117",
    "kysely": "0.29.6",
    "kysely-d1": "0.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.8.0",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1",
    "trakoo": "2.4.0",
    "uqr": "0.1.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.58.0",
    "@cloudflare/workers-types": "5.20260924.1",
    "@effect/platform-node": "4.0.0-rc.117",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.40",
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "alchemy": "2.0.0-beta.79",
    "atmn": "2.0.28",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-plugin-effect": "0.12.1",
    "standardwebhooks": "1.1.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "ultracite": "7.12.0",
    "vite": "8.3.0",
    "wrangler": "4.137.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.4.1"
}
